{{ define "header" }}<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>axhixh</title>
  <link rel="me" href="https://www.axhixh.com.np" />
  <link rel="me" href="https://github.com/axhixh/" />
  <link rel="stylesheet" href="/site.css">
  <script defer src="https://use.fontawesome.com/releases/v5.3.1/js/all.js"></script>
  <!-- open graph -->
  <meta property="og:title" content="{{.Title}}" />
  <meta property="og:type" content="article" />
  <meta property="og:url" content="{{.Url}}" />
  <link rel="alternate" type="application/atom+xml" title="atom feed for axhixh" href="/axhixh.atom" />
</head>
<body data-theme="system"><main>
{{ end }}

{{ define "footer" }}
<footer class="footer">
  <div class="container">
    <div class="has-text-left">
      <p>
        <a href="/"><span class="icon is-large"><i class="fas fa-home"></i></span>Home</a>
        <a href="/tags/"><span class="icon is-large"><i class="fas fa-tags"></i></span>Tags</a>
        <a href="/axhixh.atom"><span class="icon is-large"><i class="fas fa-rss"></i></span>Atom Feed</a>
        <a href="https://github.com/axhixh/" rel="me"><span class="icon is-large"><i class="fab fa-github"></i></span>Github</a> 
      </p>
      <p xmlns:cc="http://creativecommons.org/ns#" >
        <a rel="cc:attributionURL" href="https://www.axhixh.com.np">This site</a>
        &copy; 2014 - 2026 by <span property="cc:attributionName">Ashish Shrestha</span>
        is licensed under
        <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/?ref=chooser-v1" 
        target="_blank" rel="license noopener noreferrer" 
        style="display:inline-block;">CC BY-NC-SA 4.0
        <img style="height:22px!important;margin-left:3px;vertical-align:text-bottom;" 
        src="https://mirrors.creativecommons.org/presskit/icons/cc.svg?ref=chooser-v1" 
        alt="">
        <img style="height:22px!important;margin-left:3px;vertical-align:text-bottom;" 
        src="https://mirrors.creativecommons.org/presskit/icons/by.svg?ref=chooser-v1" 
        alt="">
        <img style="height:22px!important;margin-left:3px;vertical-align:text-bottom;" 
        src="https://mirrors.creativecommons.org/presskit/icons/nc.svg?ref=chooser-v1" 
        alt="">
        <img style="height:22px!important;margin-left:3px;vertical-align:text-bottom;"
        src="https://mirrors.creativecommons.org/presskit/icons/sa.svg?ref=chooser-v1" 
        alt="">
        </a>
      </p> 
    </div>
      <div class="theme-select-wrapper">
        <label for="theme-dropdown" class="meta-label">Theme:</label>
        <select id="theme-dropdown" class="theme-select" onchange="setTheme(this.value)">
          <option value="system">System</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
      </div>
  </div>
</footer>
 <!-- Inline Theme Switching Logic -->
  <script>
    function setTheme(mode) {
      document.body.setAttribute('data-theme', mode);
      localStorage.setItem('blog-theme', mode);
      document.getElementById('theme-dropdown').value = mode;
    }

    // Apply stored theme setting on load
    (function() {
      const savedTheme = localStorage.getItem('blog-theme') || 'system';
      setTheme(savedTheme);
    })();
  </script>
</main></body>
</html>{{ end }}

{{define "date"}}
<time datetime="{{ .Format "2006-01-02T15:04:05Z07:00" }}">{{ .Format "Jan 02, 2006" }}</time>
{{end}}

{{ define "page" }}
{{ template "header" . }}
{{ .Content }}
{{ template "footer" . }}
{{ end }}

{{ define "post" }}
<article>
<header class="article-header">
<h1 class="article-title">{{ .Title }}</h1>
</header>
<div class='article-body'>
{{ .Content }}
</div> <!-- content -->
<hr>
<div class="article-meta">
  <div class="meta-dates">
{{ if .Other.Created }}
    <div class="meta-item">
      <span class="meta-label">Published:</span>
      <time datetime="{{ .Other.Created }}">{{ .Other.Created }}</time>
    </div>
    <div class="meta-item">
      <span class="meta-label">Updated:</span>
      {{template "date" .Date}}
    </div>
{{ else }}
    <div class="meta-item">
      <span class="meta-label">Published:</span>
      {{template "date" .Date}}
    </div>
{{end}}
  </div>
</div>
<div class="meta-tags">
<span class="meta-label">Tags: </span>
{{ range .Tags}}
<a href="/tags/{{.}}/"><span class="tag">#{{.}}</span></a>&nbsp;
{{end}}
</div>
</article>
{{ end }}

{{define "tag"}}
<div class="tag is-large is-danger"> {{.Title}}</div>
<hr>
<ul class="post-list">
{{ range .Site.Pages.WithTag .Title }}
<li class="mb-1">
    <div><a href="{{ $.Rel .Url }}">{{ .Title }}</a></div>
    <div class="is-size-7 is-grey-lighter">{{ template "date" .Date }}</div>
  </li>
{{ end }}
</ul>
{{ end }}
