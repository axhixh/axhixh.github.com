    </div>
  </div>
</footer>
</main></body>
</html>{{ end }}

{{define "date"}}
<time datetime="{{ .Format "2006-01-02" }}">{{ .Format "Jan 02, 2006" }}</time>
{{end}}

{{ define "page" }}
{{ template "header" . }}
{{ .Content }}
{{ template "footer" . }}
{{ end }}

{{ define "post" }}
<article>
<header class="article-header">
<h1 class="article-title">{{ .Title }}</h1>
</header>
<div class='article-body'>
{{ .Content }}
</div> <!-- content -->
<hr>
<div class="article-meta">
  <div class="meta-dates">
{{ if .Other.Created }}
    <div class="meta-item">
      <span class="meta-label">Published:</span>
      <time datetime="{{ .Other.Created }}">{{ .Other.Created }}</time>
    </div>
    <div class="meta-item">
      <span class="meta-label">Updated:</span>
      {{template "date" .Date}}
    </div>
{{ else }}
    <div class="meta-item">
      <span class="meta-label">Published:</span>
      {{template "date" .Date}}
    </div>
{{end}}
  </div>
</div>
<div class="meta-tags">
<span class="meta-label">Tags: </span>
{{ range .Tags}}
<a href="/tags/{{.}}/"><span class="tag">#{{.}}</span></a>
{{end}}
</div>
</article>
{{ end }}

{{define "tag"}}
<div class="tag"> {{.Title}}</div>
<hr>
<ul class="post-list">
{{ range .Site.Pages.WithTag .Title }}
<li class="mb-1">
    <div><a href="{{ $.Rel .Url }}">{{ .Title }}</a></div>
    <div>{{ template "date" .Date }}</div>
  </li>
{{ end }}
</ul>
{{ end }}
